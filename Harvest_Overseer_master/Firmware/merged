#include <SPI.h>
#include <TFT_eSPI.h>
#include <esp_now.h>
#include <WiFi.h>
#include <Preferences.h>

//display setup
TFT_eSPI tft = TFT_eSPI();

//image arrays
const unsigned short img_healthy[1]
PROGMEM = {};

const unsigned short img_unhealthy[1]
PROGMEM = {};

//plant states
enum PlantState { UNKNOWN, HEALTHY, UNHEALTHY };
PlantState currentPlantState = UNKNOWN;

//preferences setup
Preferences preferences;
float ph7Voltage = 2.5;
float ph4Voltage = 3.0;

//plant profiles
struct PlantProfile {
    float PhMin;
    float PhMax;
    float MoistureMin;
    float MoistureMax;
    float LightIntensityMin;
};

const PlantProfile plantPresets[] = {
    {"General", 6.0, 7.0, 30.0, 70.0, 1.0},
    {"Succulent", 6.0, 7.5, 10.0, 30.0, 2.0},
    {"Tropical", 5.5, 6.5, 50.0, 80.0, 0.8},
    {"Vegetable", 6.0, 7.0, 40.0, 70.0, 1.5},
    {"Herb", 5.5, 6.5, 30.0, 60.0, 1.2}
};

int currentPlantProfileIndex = 0;

//esp-now data structure
typedef struct sensorData {
    float phVoltage;
    float npkVoltage;
    float moistureVoltage;
    float lightIntensity;
} sensorData;

sensorData receivedData;

//states
volatile bool newDataReceived = false;
bool connectionLost = false;

//timers
unsigned long lastDataReceivedTime = 0;
const unsigned long connectionTimeout = 10000; // 10 seconds

//function
float calculatepH(float currentVoltage, float calibratedPh7Voltage, float calibratedPh4Voltage) {
    float slope = (7.0 - 4.0) / (calibratedPh7Voltage - calibratedPh4Voltage);
    return 7.0 + (slope * (currentVoltage - calibratedPh7Voltage));
}

PlantState checkPlantHealth(float pH, float npkVoltage, float moisturePct, float lightIntensity){
    PlantProfile p = plantPresets[currentPlantProfileIndex];

    bool pHHealthy = (pH >= p.PhMin && pH <= p.PhMax);
    bool npkHealthy = (npkVoltage >= 1.0 && npkVoltage <= 3.0);
    bool moistureHealthy = (moisturePct >= p.MoistureMin && moisturePct <= p.MoistureMax);
    bool lightHealthy = (lightIntensity >= p.LightIntensityMin);

    if (pHHealthy && npkHealthy && moistureHealthy && lightHealthy) {
        return HEALTHY;
    } else {
        return UNHEALTHY;
    }
}

const float AIR_VOLTAGE = 3.3;
const float WATER_VOLTAGE = 0.0;

float calculateMoisturePercentage(float voltage) {
    float percent = ((AIR_VOLTAGE - voltage) / (AIR_VOLTAGE - WATER_VOLTAGE)) * 100.0;

    if (percent < 0.0) percent = 0.0;
    if (percent > 100.0) percent = 100.0;

    return percent;
}

float moisturePercentage = calculateMoisturePercentage(receivedData.moistureVoltage);

const int GRAPH_POINTS = 20;
float moistureHistory[GRAPH_POINTS] = {0};
int historyIndex = 0;

void addHistoryPoint(float newMoisture) {
    for (int i = 0; i < GRAPH_POINTS - 1; i++) {
        moistureHistory[i] = moistureHistory[i + 1];
    }
    moistureHistory[GRAPH_POINTS - 1] = newMoisture;
    if (historyIndex < GRAPH_POINTS) historyIndex++;
}

void drawMoistureGraph(int originX, int originY, int w, int h) {
    tft.fillRect(originX, originY, w, h, TFT_BLACK);
    tft.drawRect(originX, originY, w, h, TFT_WHITE);

    if (historyIndex < 2) return;

    int stepX = w / (GRAPH_POINTS - 1);

    for (int i = 0; i < historyIndex - 1; i++) {
        int x1 = originX + (i * stepX);
        int y1 = originY + h - (int)((moistureHistory[i] / 100.0) * h);
        int x2 = originX + (i + 1) * stepX;
        int y2 = originY + h - (int)((moistureHistory[i + 1] / 100.0) * h);

        tft.drawLine(x1, y1, x2, y2, TFT_GREEN);
    }
}

//esp-now callback
void OnDataReceived(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
    memcpy(&receivedData, incomingData, sizeof(receivedData));
    newDataReceived = true;
    lastDataReceivedTime = millis();
}

void setup() {
    Serial.begin(115200);

    preferences.begin("sensorCalibration", false);
    ph7Voltage = preferences.getFloat("ph7Voltage", 2.5);
    ph4Voltage = preferences.getFloat("ph4Voltage", 3.0);
    
    Serial.println("Boot Complete: Loaded calibration data.");

    tft.init();

    tft.setRotation(1);
    tft.fillScreen(TFT_BLACK);

    tft.setTextColor(TFT_WHITE, TFT_BLACK);
    tft.setTextSize(2);
    tft.drawString("Harvest Overseer", 10, 10);
    tft.drawString(plantPresets[currentPlantProfileIndex].name, 10, 160);

    tft.setTextSize(2);
    tft.drawString("pH:", 10, 40);
    tft.drawString("NPK Voltage:", 10, 70);
    tft.drawFloat(moisturePercentage, 0, 150, 100);
    tft.print(" %");
    tft.drawString("Light Intensity:", 10, 130);

    WiFi.mode(WIFI_STA);
    if (esp_now_init() != ESP_OK) {
        tft.setTextColor(TFT_RED, TFT_BLACK);
        tft.drawString("Error: ESP-NOW init failed", 10, 130);
        return;
    }
    esp_now_register_recv_cb(OnDataReceived);

    lastDataReceivedTime = millis();

}


void loop() {

    

    if (millis() - lastDataReceivedTime > connectionTimeout) {
        if (!connectionLost) {
            tft.setTextColor(TFT_RED, TFT_BLACK);
            tft.drawString("Connection Lost", 10, 160);
            tft.drawString("---.---", 10, 40);
            tft.drawString("---.---", 10, 70);
            tft.drawString("---.---", 10, 100);
            tft.drawString("---.---", 10, 130);

            connectionLost = true;
        }
    }

    if (newDataReceived) {

        if (connectionLost) {
            tft.fillRect(10, 160, 200, 20, TFT_BLACK);

            connectionLost = false;
        }

        addHistoryPoint(moisturePercentage);
        drawMoistureGraph(160, 150, 140, 60);

        float pHvalue = calculatepH(receivedData.phVoltage, ph7Voltage, ph4Voltage);

        tft.setTextColor(TFT_WHITE, TFT_BLACK);
        tft.setTextSize(2);
        tft.drawFloat(pHvalue, 2, 150, 40);
        tft.drawFloat(receivedData.npkVoltage, 2, 150, 70);
        tft.drawFloat(moisturePercentage, 0, 150, 100);
        tft.print(" %");
        tft.drawFloat(receivedData.lightIntensity, 2, 150, 130);

        newDataReceived = false;

        // Update plant state based on sensor data
        float moisturePercentage = calculateMoisturePercentage(receivedData.moistureVoltage);

        PlantState newState = checkPlantHealth(pHvalue, receivedData.npkVoltage, moisturePercentage, receivedData.lightIntensity);
          
        if (newState !=  currentPlantState) {
            
            tft.fillRect(10, 40, 320, 160, TFT_BLACK); // Clear the image

            tft.setTextColor(TFT_WHITE);
            tft.setTextSize(2);

            if (newState == HEALTHY) {
                tft.drawString("Plant is Helth", 10, 40);
                tft.pushImage(10, 40, 100, 100, img_healthy);
            } else if (newState == UNHEALTHY) {
                tft.setTextColor(TFT_RED);
                tft.drawString("Plant is Unhelth", 10, 40);
                tft.pushImage(10, 40, 100, 100, img_unhealthy);
            }

            currentPlantState = newState;
        }

        newDataReceived = false;
    }
}