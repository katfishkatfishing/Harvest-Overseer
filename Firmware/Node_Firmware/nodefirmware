#include <esp_now.h>
#include <WiFi.h>

//sensor pins
const int phPin = 3;
const int npkPin = 4;
const int moisturePin = 5;
const int lightPin = 6;

//esp-now broadcast address
uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

typedef struct __attribute__((packed)) sensorData {
    float phVoltage;
    float npkVoltage;
    float moistureVoltage;
    float lightIntensity;
} sensorData;

sensorData outgoingData;
esp_now_peer_info_t peerInfo;

//callback function 
void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
    Serial.print("Last Packet Send Status: ");
    Serial.println(status == ESP_NOW_SEND_SUCCESS ? "Delivery Success" : "Delivery Fail");
}

void setup() {
    Serial.begin(115200);

    pinMode(phPin, INPUT);
    pinMode(npkPin, INPUT);
    pinMode(moisturePin, INPUT);
    pinMode(lightPin, INPUT);

    WiFi.mode(WIFI_STA);

    if (esp_now_init() != ESP_OK) {
        Serial.println("Error: ESP-NOW initialization failed");
        return;
    }

    esp_now_register_send_cb(OnDataSent);

    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = 0;
    peerInfo.encrypt = false;

    if (esp_now_add_peer(&peerInfo) != ESP_OK) {
        Serial.println("Error: Failed to add peer");
        return;
    }

    Serial.println("ESP-NOW Initialized.");
}

void loop() {

    uint32_t phMv = 0, npkMv = 0, moistureMv = 0, lightMv = 0;

    for (int i = 0; i < 16; i++) {
        phMv += analogReadMilliVolts(phPin);
        npkMv += analogReadMilliVolts(npkPin);
        moistureMv += analogReadMilliVolts(moisturePin);
        lightMv += analogReadMilliVolts(lightPin);
        delay(5);
    }

    float phVoltage = (phMv / 16.0) / 1000.0;
    float npkVoltage = (npkMv / 16.0) / 1000.0;
    float moistureVoltage = (moistureMv / 16.0) / 1000.0;
    float lightIntensity = (lightMv / 16.0) / 1000.0;

    outgoingData.phVoltage = phVoltage;
    outgoingData.npkVoltage = npkVoltage;
    outgoingData.moistureVoltage = moistureVoltage;
    outgoingData.lightIntensity = lightIntensity;

    esp_err_t result = esp_now_send(broadcastAddress, (uint8_t *)&outgoingData, sizeof(outgoingData));

    if (result == ESP_OK) {
        Serial.println("Sent with success");
    } else {
        Serial.println("Error sending the data");
    }

    delay(2000); 
}